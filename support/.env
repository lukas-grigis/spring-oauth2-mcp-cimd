# Port mappings (host side). WEB_PORT fronts Keycloak at http://localhost/auth AND the CIMD client
# metadata document at http://localhost/cimd-client/client.json via Traefik. Changing it (e.g. 8080)
# also changes the metadata document's URL — which IS the client_id inside
# cimd-client/client.json, so that file must be updated to match. DB_PORT publishes Postgres so the
# host-run authorization server can reach the `authserver` database.
WEB_PORT = "80"
DB_PORT = "5432"

# Images
TRAEFIK_IMAGE = "traefik:3.7"
KEYCLOAK_IMAGE = "quay.io/keycloak/keycloak:26.6"
POSTGRES_IMAGE = "postgres:18"
NGINX_IMAGE = "nginx:1.29-alpine"
