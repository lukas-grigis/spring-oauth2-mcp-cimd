# Keycloak container env (docker-compose env_file). Minimal dev setup behind Traefik.

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# Persist realm state in the shared Postgres, in a dedicated `keycloak` database (created by the
# postgres init script). A compose env_file cannot cross-reference another service's variables, so the
# credentials mirror support/database/.env.
KC_DB=postgres
KC_DB_URL_HOST=database
KC_DB_URL_DATABASE=keycloak
KC_DB_USERNAME=admin
KC_DB_PASSWORD=admin

# Served under /auth behind Traefik. KC_HOSTNAME pins the external base URL so the OIDC discovery issuer
# + redirects are identical for the browser AND a host-run back-channel client (the authorization server).
# Using localhost (not *.localhost) means a host-run JVM resolves the issuer too. KC_PROXY_HEADERS lets
# Keycloak honour Traefik's X-Forwarded-* headers.
KC_HTTP_RELATIVE_PATH=/auth
KC_HOSTNAME=http://localhost/auth
KC_HTTP_ENABLED=true
KC_PROXY_HEADERS=xforwarded
