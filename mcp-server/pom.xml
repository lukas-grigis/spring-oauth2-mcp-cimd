<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.lukasgrigis.blog.mcp</groupId>
    <artifactId>spring-oauth2-mcp-cimd</artifactId>
    <version>0.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>mcp-server</artifactId>
  <name>MCP Server</name>
  <description>Spring AI MCP server (:9200, Streamable HTTP) secured as an OAuth2 resource server: scope-gated tools
    validate the authorization server's ES256 JWTs
  </description>

  <dependencies>
    <!-- Spring AI MCP server, Streamable HTTP over WebMVC (auto-discovers @McpTool beans) -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
    </dependency>

    <!-- MCP resource-server security: RFC 9728 PRM discovery + JWKS-backed ES256 JWT validation -->
    <dependency>
      <groupId>org.springaicommunity</groupId>
      <artifactId>mcp-server-security-spring-boot</artifactId>
    </dependency>
    <!-- OAuth2 resource server: McpServerOAuth2Configurer builds on http.oauth2ResourceServer(...) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>

    <!-- Bean Validation: validates the MCP security @ConfigurationProperties (issuer-uri) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- Health probe used by the demo startup wait-loop -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Method-security slice tests: prove the @PreAuthorize scope gates offline (no JWKS, no web) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>build-info</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
